{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderSubmitted",
  "type": "object",
  "required": [
    "eventType",
    "eventVersion",
    "orderId",
    "accountId",
    "instrumentId",
    "side",
    "orderType",
    "timeInForce",
    "quantity",
    "timestamp"
  ],
  "properties": {
    "eventType": {
      "const": "OrderSubmitted"
    },
    "eventVersion": {
      "const": 1
    },
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "instrumentId": {
      "type": "string",
      "format": "uuid"
    },
    "side": {
      "enum": ["BUY", "SELL"]
    },
    "orderType": {
      "enum": ["MARKET", "LIMIT"]
    },
    "timeInForce": {
      "enum": ["DAY", "GTC", "IOC", "FOK"]
    },
    "price": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "quantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
